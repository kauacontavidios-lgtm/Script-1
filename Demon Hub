local function makeSlider(name, y, min, max, initial)
    local label = Instance.new("TextLabel")
    label.Position = UDim2.fromOffset(15, y)
    label.Size = UDim2.new(1, -30, 0, 24)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Font = Enum.Font.Gotham
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = main

    local bar = Instance.new("TextButton")
    bar.Position = UDim2.fromOffset(15, y + 30)
    bar.Size = UDim2.new(1, -30, 0, 10)
    bar.BackgroundColor3 = Color3.fromRGB(65, 45, 50)
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = main

    Instance.new("UICorner", bar).CornerRadius =
        UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Color3.fromRGB(230, 30, 55)
    fill.BorderSizePixel = 0
    fill.Parent = bar

    Instance.new("UICorner", fill).CornerRadius =
        UDim.new(1, 0)

    local value = initial

    local function update(x)
        local a = math.clamp(
            (x - bar.AbsolutePosition.X) /
            bar.AbsoluteSize.X, 0, 1
        )

        value = math.floor(min + a * (max - min) + 0.5)
        fill.Size = UDim2.new(a, 0, 1, 0)
        label.Text = name .. ": " .. value
    end

    bar.Activated:Connect(function(input)
        update(input.Position.X)
    end)

    label.Text = name .. ": " .. value
    fill.Size = UDim2.new(
        (value - min) / (max - min), 0, 1, 0
    )

    return function()
        return value
    end
end

local distance = makeSlider("ESP Distance (demo)", 65, 100, 1200, 1200)
local fov = makeSlider("FOV (demo)", 125, 10, 300, 120)
local transparency = makeSlider("FOV Transparency (demo)", 185, 0, 100, 50)

