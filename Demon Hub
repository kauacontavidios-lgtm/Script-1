local function section(page, name)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -5, 0, 30)
    label.BackgroundTransparency = 1
    label.Text = "  " .. name
    label.TextColor3 = C.red
    label.Font = Enum.Font.GothamBold
    label.TextSize = 17
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = page
end

local function addToggle(page, name, defaultValue)
    local enabled = defaultValue or false

    local b = button(
        page, "", UDim2.new(1, -5, 0, 36),
        UDim2.new()
    )
    b.BackgroundColor3 = C.row
    b.TextXAlignment = Enum.TextXAlignment.Left

    local function render()
        settings.toggles[name] = enabled
        b.Text = (enabled and "  [ON]   " or "  [OFF]  ") .. name
        b.BackgroundColor3 = enabled and C.redDark or C.row
    end

    b.Activated:Connect(function()
        enabled = not enabled
        render()
    end)

    render()
    return b
end

local function addSlider(page, name, key, min, max, initial, suffix)
    settings[key] = initial

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -5, 0, 67)
    holder.BackgroundColor3 = C.row
    holder.BorderSizePixel = 0
    holder.Parent = page
    Instance.new("UICorner", holder).CornerRadius =
        UDim.new(0, 7)

    local label = Instance.new("TextLabel")
    label.Position = UDim2.fromOffset(9, 3)
    label.Size = UDim2.new(1, -18, 0, 23)
    label.BackgroundTransparency = 1
    label.TextColor3 = C.white
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local track = Instance.new("TextButton")
    track.Position = UDim2.fromOffset(9, 39)
    track.Size = UDim2.new(1, -18, 0, 12)
    track.BackgroundColor3 = C.off
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = holder
    Instance.new("UICorner", track).CornerRadius =
        UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = C.red
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius =
        UDim.new(1, 0)

    local value = initial
    local held = false

    local function updateFromX(x)
        local alpha = math.clamp(
            (x - track.AbsolutePosition.X) /
            math.max(track.AbsoluteSize.X, 1), 0, 1
        )
        value = math.floor(min + alpha * (max - min) + 0.5)
        settings[key] = value
        local ratio = (value - min) / (max - min)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        label.Text = name .. ": " .. value .. (suffix or "")
    end

    track.Activated:Connect(function(input)
        updateFromX(input.Position.X)
    end)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            held = true
            updateFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if held and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            updateFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            held = false
        end
    end)

    local ratio = (initial - min) / (max - min)
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    label.Text = name .. ": " .. initial .. (suffix or "")
end

